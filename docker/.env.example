# Copie para docker/.env e ajuste. Valores de exemplo SÓ para uso local; troque se expuser a rede.

# pasta do computador com credit_card_fraud.csv (montada somente leitura no Airflow)
DADOS_DIR=../input

POSTGRES_PASSWORD=troque_esta_senha

# login do Airflow (http://localhost:8080)
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=troque_esta_senha
# Linux/macOS: use o seu id (comando: id -u). No Windows/Docker Desktop pode ficar 50000
AIRFLOW_UID=50000

# gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=troque_esta_chave_longa_e_aleatoria
